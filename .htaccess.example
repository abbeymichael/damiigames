# ==============================================================================
# DAMII - Apache & Shared Hosting Configuration (.htaccess)
# ==============================================================================
# This file provides two common deployment configurations for shared hosting:
#
# Option A: Reverse Proxy to Node.js backend running on local port (e.g. 3000)
# Option B: Phusion Passenger (cPanel "Setup Node.js App")
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS (Optional, uncomment if SSL certificate is installed)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Directly serve existing files from assets, dist/client, or public if they exist
    RewriteCond %{REQUEST_URI} ^/assets/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/assets/%1 -f
    RewriteRule ^assets/(.*)$ assets/$1 [L]

    RewriteCond %{REQUEST_URI} ^/assets/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/dist/client/assets/%1 -f
    RewriteRule ^assets/(.*)$ dist/client/assets/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. WebSocket Reverse Proxy Support
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^(.*)$ ws://127.0.0.1:3000/$1 [P,L]

    # 4. HTTP Reverse Proxy to Node.js backend
    # If not accessing an existing physical file, pass to Node.js server
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>

<IfModule mod_proxy.c>
    ProxyPreserveHost On
    ProxyTimeout 300
</IfModule>

# ==============================================================================
# Security Headers & Caching
# ==============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
